<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cafe_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Pedido Operativo"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/cafe_espresso"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etNombreTarea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción del pedido (ej. Café Latte x2)"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbUrgente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedido Prioritario / Express"
            android:textColor="@color/cafe_text"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prioridad de atención:"
            android:textColor="@color/cafe_espresso"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <RadioGroup
            android:id="@+id/rgPrioridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbBaja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Baja" />

            <RadioButton
                android:id="@+id/rbMedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Media" />

            <RadioButton
                android:id="@+id/rbAlta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Alta" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calificación de complejidad:"
            android:textColor="@color/cafe_espresso"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <RatingBar
            android:id="@+id/ratingImportancia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="@color/cafe_caramel"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso de preparación:"
            android:textColor="@color/cafe_espresso"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <ProgressBar
            android:id="@+id/progressTarea"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/cafe_caramel"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirmar y Guardar"
            android:textColor="@color/white"
            android:backgroundTint="@color/cafe_espresso"
            android:layout_marginTop="32dp" />

    </LinearLayout>
</ScrollView>